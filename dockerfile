# Используем стабильную LTS версию Node.js на базе Alpine
FROM node:20-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы конфигурации зависимостей
COPY package*.json ./

# Устанавливаем только необходимые для продакшена зависимости
RUN npm ci --only=production

# Копируем оставшийся исходный код приложения
COPY . .

# Команда для запуска бота
CMD ["npm", "start"]